# Testing Environment Configuration
# Copy this file to .env.testing and fill in real values
# NEVER commit .env.testing with real credentials!

APP_NAME=Laravel
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database - Use a separate test database
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=your_test_database
DB_USERNAME=your_db_user
DB_PASSWORD=your_secure_password

# Testing optimizations
BROADCAST_CONNECTION=log
CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array

# Mail - Use array driver for testing (no real emails sent)
MAIL_MAILER=array
