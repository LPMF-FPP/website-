{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "generation", "signature_valid", "releases"],
  "properties": {
    "schema_version": {"const": 1},
    "generation": {"type": "string", "minLength": 1},
    "signature_valid": {"const": true},
    "releases": {"type": "array", "items": {"$ref": "#/$defs/release"}}
  },
  "$defs": {
    "release": {
      "type": "object",
      "required": ["release_id", "version", "image", "digest", "approved", "revoked"],
      "properties": {
        "release_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$"},
        "version": {"type": "string", "minLength": 1},
        "image": {"type": "string", "pattern": "^.+@sha256:[a-f0-9]{64}$"},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "approved": {"const": true},
        "revoked": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
