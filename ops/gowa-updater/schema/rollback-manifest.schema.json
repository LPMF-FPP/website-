{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "previous_image", "project", "service", "working_directory", "compose_files", "image_override", "network_mode", "restart_policy", "mounts", "fixed_config_hash", "catalog_generation", "policy_version", "secret_source"],
  "properties": {
    "schema_version": {"const": 1},
    "previous_image": {"type": "string", "pattern": "^.+@sha256:[a-f0-9]{64}$"},
    "project": {"const": "go-whatsapp-web-multidevice"},
    "service": {"const": "whatsapp_go"}
    ,"working_directory": {"type": "string", "pattern": "^/[^\u0000]*$"}
    ,"compose_files": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string", "pattern": "^/[^\u0000]*$"}}
    ,"image_override": {"type": "string", "pattern": "^/[^\u0000]*$"}
    ,"network_mode": {"const": "host"}
    ,"restart_policy": {"const": "unless-stopped"}
    ,"mounts": {"type": "array", "items": {"type": "object", "required": ["Type", "Source", "Destination", "RW"], "properties": {"Type": {"type": "string"}, "Source": {"type": "string"}, "Destination": {"type": "string"}, "RW": {"type": "boolean"}}, "additionalProperties": false}}
    ,"fixed_config_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    ,"catalog_generation": {"type": "string", "minLength": 1, "maxLength": 128}
    ,"policy_version": {"type": "string", "minLength": 1, "maxLength": 64}
    ,"secret_source": {"type": "string", "pattern": "^[A-Za-z0-9._:/-]{1,255}$"}
  },
  "additionalProperties": false
}
